#!/usr/bin/env python3
"""Lightweight Python 3.11+ foundation validation; secret scan is heuristic."""
from pathlib import Path
import re
import sys
import tomllib
R = Path(__file__).resolve().parent.parent
required = ['AGENTS.md','README.md','VERSION','principles/drivelyn-core-principles.md','principles/learning-safety.md','principles/issue-policy.md','principles/review-policy.md','reviewer-templates/learning-safety-reviewer.toml','skill-templates/README.md','contract-governance/api-consumer-rules.md','templates/codex-evaluation.md','templates/reviewer-trigger-matrix.md','scripts/validate-foundation','principles/autonomous-work-policy.md','skill-templates/drivelyn-issue-to-pr/SKILL.md','templates/draft-pr.md']
errors = []
for name in required:
    p = R / name
    if p.is_symlink() or not p.is_file() or not p.read_text().strip():
        errors.append(f'{name}: missing, empty or symlinked')
try:
    version = (R/'VERSION').read_text().strip()
    if not re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)',version) or version not in (R/'README.md').read_text():
        errors.append('invalid or inconsistent version')
    role = tomllib.loads((R/'reviewer-templates/learning-safety-reviewer.toml').read_text())
    if set(role) != {'name','description','sandbox_mode','developer_instructions'} or role.get('name') != 'learning-safety-reviewer' or role.get('sandbox_mode') != 'read-only' or 'Do not edit' not in role.get('developer_instructions',''):
        errors.append('invalid read-only reviewer template')
    if len(re.findall(r'^\d+\.',(R/'principles/drivelyn-core-principles.md').read_text(),re.M)) != 12:
        errors.append('expected twelve principles')
except (OSError,ValueError) as e:
    errors.append(str(e))
for p in R.rglob('*'):
    if '.git' in p.parts or not p.is_file():
        continue
    if p.is_symlink():
        errors.append(f'{p.relative_to(R)}: symlink')
    content = p.read_text()
    if re.search(r'/(?:Users|home)/[\w.-]+|[A-Z]:\\Users\\',content):
        errors.append(f'{p.relative_to(R)}: personal path')
    if re.search(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|(?:ghp_|sk_live_)[A-Za-z0-9]{16,}',content):
        errors.append(f'{p.relative_to(R)}: possible secret')
    if p.suffix == '.md':
        for target in re.findall(r'\]\(([^)]+)\)',content):
            target = target.strip('<>').split('#',1)[0]
            if not target or re.match(r'^[a-zA-Z][a-zA-Z0-9+.-]*:',target):
                continue
            resolved = (p.parent/target).resolve()
            if not resolved.is_relative_to(R) or not resolved.exists():
                errors.append(f'{p.relative_to(R)}: broken/nonlocal link {target}')
if errors:
    sys.exit('\n'.join('FAIL: '+e for e in errors))
print('PASS: foundation structure, version, links, path/secret heuristics and reviewer')
